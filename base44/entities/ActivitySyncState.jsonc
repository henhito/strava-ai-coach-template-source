{
  "name": "ActivitySyncState",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "syncing",
        "complete",
        "partial",
        "failed",
        "unknown"
      ],
      "default": "unknown"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "athlete_id",
    "status"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}